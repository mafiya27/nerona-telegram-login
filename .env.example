# Required — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=<redacted>

# Optional — comma-separated Telegram user IDs allowed to log in.
# Leave empty to allow anyone who messages the bot.
# Find your ID via @userinfobot
ALLOWED_IDS=

# Optional — login token lifetime in seconds (default 30 days)
TOKEN_TTL_SECONDS=2592000

# Optional — license session lifetime in seconds (default 30 days)
SESSION_TTL_SECONDS=2592000

# Required for one-time webhook setup — pick a long random string
SETUP_SECRET=<redacted>

# ── Supabase (free tier) — license server database ──
# Project Settings → API in the Supabase dashboard
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=<redacted>

# Auto-create a trial license on first /api/activate for a new Telegram user
AUTO_PROVISION=true
TRIAL_DAYS=7

# ── Admin API — pick a long random string, never commit the real one ──
# All /api/admin/* endpoints require header: X-Admin-Secret: <value>
ADMIN_SECRET=<redacted>

# Optional — Telegram chat/channel ID that receives hit notifications from /api/hits.
# Leave empty to disable server-side notifications.
TELEGRAM_NOTIFY_CHAT_ID=
